        }

        function toggleUserVip() {
            document.getElementById('foundUserStatus').textContent = "⭐ VIP Foydalanuvchi • Cheklovsiz";
            document.getElementById('foundUserStatus').className = "text-[11px] text-ios-orange font-semibold";
            showToast("Foydalanuvchiga VIP maqomi berildi!", "Admin Action", "fa-solid fa-star text-ios-orange");
        }

        function toggleUserBan() {
            currentFoundUserBanned = !currentFoundUserBanned;
            const btn = document.getElementById('banUserBtn');
            const st = document.getElementById('foundUserStatus');
            if (currentFoundUserBanned) {
