                showToast("Majburiy obuna vaqtincha o'chirildi", "Admin Sozlamalar", "fa-solid fa-lock-open text-ios-orange");
            }
        }

        function searchUserAdmin() {
            const q = document.getElementById('adminUserSearchInput').value.trim();
            if (!q) {
                showToast("User ID yoki username kiriting", "Qidiruv", "fa-solid fa-magnifying-glass text-ios-cyan");
