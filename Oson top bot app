<!DOCTYPE html>
<html lang="uz" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Oson Top Bot — Telegram Mini App</title>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Inter & SF Pro Display Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', 'SF Pro Display', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        ios: {
                            blue: '#0A84FF',
                            cyan: '#5AC8FA',
                            purple: '#BF5AF2',
                            pink: '#FF375F',
                            green: '#30D158',
                            orange: '#FF9F0A',
                            red: '#FF453A'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        input, textarea, pre, code {
            user-select: text;
        }
        body {
            background-color: #05070f;
            color: #ffffff;
            overflow-x: hidden;
            min-height: 100vh;
            position: relative;
        }

        /* iOS 18 / VisionOS Ambient Animated Background Blobs */
        .ambient-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            overflow: hidden;
            background: radial-gradient(circle at 50% 0%, #0f172a 0%, #03050a 100%);
        }
        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.48;
            animation: floatBlob 18s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
        }
        .blob-1 {
            width: 340px;
            height: 340px;
            background: linear-gradient(135deg, #0A84FF, #5E5CE6);
            top: -80px;
            left: -70px;
        }
        .blob-2 {
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, #BF5AF2, #FF375F);
            top: 32%;
            right: -90px;
            animation-delay: -5s;
        }
        .blob-3 {
            width: 320px;
            height: 320px;
            background: linear-gradient(135deg, #5AC8FA, #30D158);
            bottom: -60px;
            left: 10%;
            animation-delay: -10s;
        }
        @keyframes floatBlob {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(35px, -30px) scale(1.12); }
            100% { transform: translate(-25px, 25px) scale(0.92); }
        }

        /* Apple VisionOS Frosted Glass Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.065);
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
            border-radius: 24px;
        }
        .glass-pill {
            background: rgba(255, 255, 255, 0.09);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.16);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }
        .glass-input {
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.45);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .glass-input:focus-within {
            border-color: rgba(10, 132, 255, 0.75);
            box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.25), inset 0 2px 6px rgba(0, 0, 0, 0.45);
        }

        /* iOS Spring Button Effect */
        .ios-btn {
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease, box-shadow 0.2s ease;
        }
        .ios-btn:active {
            transform: scale(0.95);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 999px;
        }

        /* Shimmer & Pulse effects */
        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(200%); }
        }
        .scan-effect {
            animation: scanline 1.8s infinite linear;
        }
    </style>
</head>
<body class="pb-28 antialiased selection:bg-ios-blue selection:text-white">

    <!-- Ambient Animated Background -->
    <div class="ambient-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <!-- Top Toast Notification (No alert() used!) -->
    <div id="toastContainer" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 -translate-y-4 w-[92%] max-w-md">
        <div class="glass-pill rounded-2xl px-4 py-3 flex items-center gap-3 shadow-2xl border border-white/25">
            <div id="toastIcon" class="w-8 h-8 rounded-full bg-ios-blue/20 text-ios-blue flex items-center justify-center shrink-0">
                <i class="fa-solid fa-bell"></i>
            </div>
            <div class="flex-1 min-w-0">
                <p id="toastTitle" class="text-xs font-bold uppercase tracking-wider text-white/70">Oson Top Tizimi</p>
                <p id="toastMessage" class="text-sm font-medium text-white truncate">Muvaffaqiyatli bajarildi!</p>
            </div>
        </div>
    </div>

    <!-- Main Container -->
    <main class="max-w-lg mx-auto px-4 pt-3 space-y-4">

        <!-- TOP HEADER: User Profile Capsule + Role Switcher (User vs Admin) -->
        <header class="glass-card p-3 flex items-center justify-between gap-2">
            <!-- User Info -->
            <div class="flex items-center gap-3 min-w-0">
                <div class="relative shrink-0">
                    <div id="userAvatar" class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-ios-blue via-ios-purple to-ios-pink p-[2px] shadow-lg">
                        <div class="w-full h-full rounded-[14px] bg-slate-900 flex items-center justify-center text-base font-bold" id="avatarInitials">
                            OT
                        </div>
                    </div>
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-ios-green border-2 border-[#0a0f1d] rounded-full"></span>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                        <h1 id="userNameDisplay" class="font-bold text-sm sm:text-base truncate">Oson Top Foydalanuvchi</h1>
                        <span id="roleBadge" class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-ios-blue/25 text-ios-cyan border border-ios-cyan/30">
                            PRO
                        </span>
                    </div>
                    <p id="userSubDisplay" class="text-xs text-white/55 truncate">@oson_top_bot • VisionOS UI</p>
                </div>
            </div>

            <!-- Role Switcher Toggle (User vs Admin Panel) -->
            <div class="glass-pill p-1 rounded-2xl flex items-center shrink-0">
                <button id="btnRoleUser" onclick="switchRole('user')" class="ios-btn px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 bg-white/20 text-white shadow-sm">
                    <i class="fa-solid fa-user text-[11px]"></i>
                    <span>User</span>
                </button>
                <button id="btnRoleAdmin" onclick="switchRole('admin')" class="ios-btn px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 text-white/60 hover:text-white">
                    <i class="fa-solid fa-shield-halved text-[11px]"></i>
                    <span>Admin</span>
                </button>
            </div>
        </header>

        <!-- ==========================================
             1. USER PANEL VIEW (Media Downloader)
             ========================================== -->
        <section id="userPanelView" class="space-y-4">

            <!-- SUB-TAB: HOME (Downloader) -->
            <div id="userTabHome" class="space-y-4">
                
                <!-- Hero Banner & Platform Badges -->
                <div class="glass-card p-5 relative overflow-hidden">
                    <div class="absolute -right-8 -top-8 w-32 h-32 bg-ios-blue/20 rounded-full blur-2xl pointer-events-none"></div>
                    
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <span class="text-[11px] font-semibold uppercase tracking-widest text-ios-cyan">Tezkor Media Yuklovchi</span>
                            <h2 class="text-xl font-extrabold tracking-tight mt-0.5">Suv belgisiz (No Watermark)</h2>
                        </div>
                        <div class="w-10 h-10 rounded-2xl glass-pill flex items-center justify-center text-ios-cyan shadow-inner">
                            <i class="fa-solid fa-bolt-lightning text-lg"></i>
                        </div>
                    </div>

                    <!-- Supported Platforms Live Glow Badges -->
                    <div class="grid grid-cols-4 gap-2 mb-4">
                        <div id="badge-instagram" class="platform-badge glass-pill rounded-xl p-2 flex flex-col items-center gap-1 border border-white/10 transition-all duration-300">
                            <i class="fa-brands fa-instagram text-lg text-pink-400"></i>
                            <span class="text-[10px] font-medium text-white/80">Instagram</span>
                        </div>
                        <div id="badge-tiktok" class="platform-badge glass-pill rounded-xl p-2 flex flex-col items-center gap-1 border border-white/10 transition-all duration-300">
                            <i class="fa-brands fa-tiktok text-lg text-cyan-300"></i>
                            <span class="text-[10px] font-medium text-white/80">TikTok</span>
                        </div>
                        <div id="badge-youtube" class="platform-badge glass-pill rounded-xl p-2 flex flex-col items-center gap-1 border border-white/10 transition-all duration-300">
                            <i class="fa-brands fa-youtube text-lg text-red-400"></i>
                            <span class="text-[10px] font-medium text-white/80">YouTube</span>
                        </div>
                        <div id="badge-pinterest" class="platform-badge glass-pill rounded-xl p-2 flex flex-col items-center gap-1 border border-white/10 transition-all duration-300">
                            <i class="fa-brands fa-pinterest text-lg text-rose-400"></i>
                            <span class="text-[10px] font-medium text-white/80">Pinterest</span>
                        </div>
                    </div>

                    <!-- URL Input Box -->
                    <div class="glass-input rounded-2xl p-2 flex items-center gap-2 mb-3">
                        <div class="pl-2.5 text-white/50">
                            <i id="detectedIcon" class="fa-solid fa-link text-base transition-all"></i>
                        </div>
                        <input 
                            id="mediaUrlInput" 
                            type="url" 
                             oninput="handleUrlInput(this.value)"
                            placeholder="Video yoki Reels havolasini kiriting..." 
                            class="w-full bg-transparent text-sm text-white placeholder-white/40 focus:outline-none py-2"
                        >
                        <button onclick="clearInput()" id="clearUrlBtn" class="hidden ios-btn w-7 h-7 rounded-full bg-white/10 text-white/60 hover:text-white items-center justify-center shrink-0">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </button>
                        <button onclick="pasteFromClipboard()" class="ios-btn px-3 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-xs font-semibold flex items-center gap-1.5 shrink-0 text-ios-cyan">
                            <i class="fa-regular fa-paste"></i>
                            <span>Qo'yish</span>
                        </button>
                    </div>

                    <!-- Quick Test Link Chips (One-tap demo links) -->
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 mb-4 no-scrollbar">
                        <span class="text-[10px] text-white/45 shrink-0 mr-1">Sinab ko'rish:</span>
                        <button onclick="fillDemoLink('instagram')" class="ios-btn text-[11px] px-2.5 py-1 rounded-full bg-pink-500/15 border border-pink-500/30 text-pink-300 shrink-0">
                            📸 Insta Reels
                        </button>
                        <button onclick="fillDemoLink('tiktok')" class="ios-btn text-[11px] px-2.5 py-1 rounded-full bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 shrink-0">
                            🎵 TikTok HD
                        </button>
                        <button onclick="fillDemoLink('youtube')" class="ios-btn text-[11px] px-2.5 py-1 rounded-full bg-red-500/15 border border-red-500/30 text-red-300 shrink-0">
                            ▶️ YT Shorts
                        </button>
                        <button onclick="fillDemoLink('pinterest')" class="ios-btn text-[11px] px-2.5 py-1 rounded-full bg-rose-500/15 border border-rose-500/30 text-rose-300 shrink-0">
                            📌 Pinterest
                        </button>
                    </div>

                    <!-- Format & Quality Segmented Control (iOS 18 style) -->
                    <div class="mb-4">
                        <label class="block text-[11px] font-medium text-white/60 mb-1.5 ml-1">Yuklash formati va sifati:</label>
                        <div class="glass-pill p-1 rounded-2xl grid grid-cols-3 gap-1">
                            <button onclick="selectFormat('hd')" id="fmt-hd" class="format-btn ios-btn py-2 px-2 rounded-xl text-xs font-semibold bg-white/20 text-white shadow flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-film text-ios-cyan"></i>
                                <span>HD 1080p</span>
                            </button>
                            <button onclick="selectFormat('nowm')" id="fmt-nowm" class="format-btn ios-btn py-2 px-2 rounded-xl text-xs font-semibold text-white/65 hover:text-white flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-wand-magic-sparkles text-ios-purple"></i>
                                <span>Suv belgisiz</span>
                            </button>
                            <button onclick="selectFormat('mp3')" id="fmt-mp3" class="format-btn ios-btn py-2 px-2 rounded-xl text-xs font-semibold text-white/65 hover:text-white flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-music text-ios-pink"></i>
                                <span>MP3 Audio</span>
                            </button>
                        </div>
                    </div>

                    <!-- Main Action Download Button -->
                    <button onclick="startMediaDownload()" id="mainDownloadBtn" class="ios-btn w-full py-3.5 px-5 rounded-2xl bg-gradient-to-r from-ios-blue via-indigo-500 to-ios-purple text-white font-bold text-sm shadow-lg shadow-ios-blue/30 border border-white/25 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-bolt"></i>
                        <span>Media faylni topish va yuklash</span>
                    </button>
                </div>

                <!-- Scanning / Fetching Loader Card (Hidden by default) -->
                <div id="loadingScannerCard" class="hidden glass-card p-5 relative overflow-hidden">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-ios-blue/20 border border-ios-blue/40 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-circle-notch fa-spin text-xl text-ios-cyan"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <h4 id="scanStatusTitle" class="text-sm font-bold text-white">Server orqali tahlil qilinmoqda...</h4>
                                <span id="scanPercent" class="text-xs font-bold text-ios-cyan">35%</span>
                            </div>
                            <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                                <div id="scanProgressBar" class="h-full bg-gradient-to-r from-ios-cyan to-ios-purple rounded-full transition-all duration-300" style="width: 35%"></div>
                            </div>
                            <p id="scanSubText" class="text-[11px] text-white/55 mt-1.5">Asl nusxadagi suv belgisiz oqim ajratib olinmoqda</p>
                        </div>
                    </div>
                </div>

                <!-- Media Result Preview Card (Displayed after fetching) -->
                <div id="mediaResultCard" class="hidden glass-card p-4 space-y-4 border border-ios-cyan/30">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-ios-green/20 text-ios-green border border-ios-green/30 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-check"></i> Yuklashga tayyor
                        </span>
                        <span id="resultFormatBadge" class="text-xs font-semibold text-white/70 bg-white/10 px-2.5 py-1 rounded-full">
                            MP4 • 1080p HD
                        </span>
                    </div>

                    <!-- Media Preview Thumbnail & Details -->
                    <div class="flex gap-3.5 items-center">
                        <div class="relative w-24 h-28 rounded-2xl overflow-hidden shrink-0 border border-white/15 bg-slate-900">
                            <img id="resultThumb" src="https://placehold.co/300x400/1e293b/38bdf8?text=Media+HD" alt="Preview" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                                <div class="w-9 h-9 rounded-full glass-pill flex items-center justify-center text-white">
                                    <i class="fa-solid fa-play text-xs ml-0.5"></i>
                                </div>
                            </div>
                            <span id="resultDuration" class="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 rounded bg-black/75 text-[10px] font-semibold">
                                00:42
                            </span>
                        </div>

                        <div class="flex-1 min-w-0 space-y-1.5">
                            <div id="resultPlatformTag" class="text-[11px] font-bold text-ios-cyan uppercase tracking-wider">
                                INSTAGRAM REELS
                            </div>
                            <h3 id="resultTitle" class="text-sm font-bold text-white line-clamp-2 leading-snug">
                                Oson Top Bot orqali topilgan yuqori sifatli media fayl
                            </h3>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-white/60 pt-1">
                                <span><i class="fa-solid fa-hard-drive mr-1 text-white/40"></i><span id="resultSize">14.2 MB</span></span>
                                <span>•</span>
                                <span><i class="fa-solid fa-wand-sparkles mr-1 text-ios-green"></i>Suv belgisiz</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons: Send to Bot Chat OR Direct Save -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                        <button onclick="sendMediaToBotChat()" class="ios-btn py-3 px-4 rounded-xl bg-ios-blue hover:bg-ios-blue/90 text-white font-semibold text-xs flex items-center justify-center gap-2 shadow-lg shadow-ios-blue/25">
                            <i class="fa-brands fa-telegram text-base"></i>
                            <span>Bot chatiga yuborish</span>
                        </button>
                        <button onclick="triggerDirectSave()" class="ios-btn py-3 px-4 rounded-xl glass-pill hover:bg-white/15 text-white font-semibold text-xs flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-down text-ios-cyan"></i>
                            <span>Qurilmaga saqlash</span>
                        </button>
                    </div>
                </div>

                <!-- Quick Features Grid -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="glass-card p-3.5 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-ios-purple/20 border border-ios-purple/30 flex items-center justify-center text-ios-purple shrink-0">
                            <i class="fa-solid fa-infinity"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-bold">Cheklovlarsiz</h4>
                            <p class="text-[11px] text-white/55">100% bepul va tez</p>
                        </div>
                    </div>
                    <div class="glass-card p-3.5 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-ios-green/20 border border-ios-green/30 flex items-center justify-center text-ios-green shrink-0">
                            <i class="fa-solid fa-headphones-simple"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-bold">Musiqani ajratish</h4>
                            <p class="text-[11px] text-white/55">Videodan MP3 olish</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SUB-TAB: HISTORY (Yuklashlar tarixi) -->
            <div id="userTabHistory" class="hidden space-y-4">
                <div class="glass-card p-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold">Yuklashlar tarixi</h2>
                        <p class="text-xs text-white/55">Oxirgi yuklab olingan media fayllaringiz</p>
                    </div>
                    <button onclick="clearHistory()" class="ios-btn px-3 py-1.5 rounded-xl bg-ios-red/20 border border-ios-red/30 text-ios-red text-xs font-semibold flex items-center gap-1.5">
                        <i class="fa-regular fa-trash-can"></i>
                        <span>Tozalash</span>
                    </button>
                </div>

                <div id="historyListContainer" class="space-y-2.5">
                    <!-- Populated via JS -->
                </div>
            </div>

            <!-- SUB-TAB: GUIDE & SAVED (Qo'llanma va ma'lumot) -->
            <div id="userTabGuide" class="hidden space-y-4">
                <div class="glass-card p-5 space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-2xl bg-ios-cyan/20 border border-ios-cyan/30 flex items-center justify-center text-ios-cyan">
                            <i class="fa-solid fa-wand-magic-sparkles text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold">Qanday ishlaydi?</h2>
                            <p class="text-xs text-white/60">3 ta oddiy qadamda media yuklab oling</p>
                        </div>
                    </div>

                    <div class="space-y-3 text-xs">
                        <div class="glass-pill p-3.5 rounded-2xl flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-ios-blue text-white font-bold flex items-center justify-center shrink-0">1</span>
                            <div>
                                <h4 class="font-bold text-white mb-0.5">Havolani nusxalang</h4>
                                <p class="text-white/65">Instagram, TikTok, YouTube yoki Pinterest ilovasidan yoqqan videongizning "Share -> Copy Link" tugmasini bosing.</p>
                            </div>
                        </div>
                        <div class="glass-pill p-3.5 rounded-2xl flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-ios-purple text-white font-bold flex items-center justify-center shrink-0">2</span>
                            <div>
                                <h4 class="font-bold text-white mb-0.5">Ilovaga joylang</h4>
                                <p class="text-white/65">"Qo'yish" tugmasini bosing va kerakli formatni (HD Video, Suv belgisiz yoki MP3 Audio) tanlang.</p>
                            </div>
                        </div>
                        <div class="glass-pill p-3.5 rounded-2xl flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-ios-green text-white font-bold flex items-center justify-center shrink-0">3</span>
                            <div>
                                <h4 class="font-bold text-white mb-0.5">Bot chatiga qabul qiling</h4>
                                <p class="text-white/65">"Bot chatiga yuborish" tugmasini bossangiz, bot darhol tayyor faylni Telegram suhbatingizga tashlab beradi!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

