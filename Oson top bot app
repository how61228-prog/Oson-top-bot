                document.getElementById(map[k]).classList.add('hidden');
                document.getElementById(`admTabBtn-${k}`).className = 'adm-tab-btn ios-btn py-2 rounded-xl text-xs font-semibold text-white/65';
            });
            document.getElementById(map[tab]).classList.remove('hidden');
            document.getElementById(`admTabBtn-${tab}`).className = 'adm-tab-btn ios-btn py-2 rounded-xl text-xs font-semibold bg-white/20 text-white shadow';
