        // Broadcast Simulator + Telegram WebApp Hook
        function sendBroadcastNow() {
            const text = document.getElementById('bcMessageText').value.trim();
            if (!text) {
                showToast("Xabar matnini kiriting!", "Xatolik", "fa-solid fa-circle-exclamation text-ios-orange");
                return;
            }

            const box = document.getElementById('bcProgressBox');
            const bar = document.getElementById('bcBar');
            const countLbl = document.getElementById('bcCountLabel');
            const statusLbl = document.getElementById('bcStatusLabel');

            box.classList.remove('hidden');
            let sent = 0;
            const total = 14892;

            const timer = setInterval(() => {
                sent += Math.floor(Math.random() * 2900) + 1800;
                if (sent >= total) {
                    sent = total;
                    clearInterval(timer);
                    statusLbl.textContent = "✅ Muvaffaqiyatli yakunlandi!";
                    showToast("Reklama posti barcha 14,892 foydalanuvchiga yetkazildi!", "Broadcast", "fa-solid fa-paper-plane text-ios-green");
                }
                const pct = Math.round((sent / total) * 100);
                bar.style.width = `${pct}%`;
                countLbl.textContent = `${sent.toLocaleString()} / ${total.toLocaleString()}`;
            }, 220);
        }

        // Mandatory Channels Manager
        function renderChannels() {
            const container = document.getElementById('channelsListContainer');
            if (mandatoryChannels.length === 0) {
                container.innerHTML = `<p class="text-xs text-white/50 text-center py-4">Ulangan kanallar yo'q</p>`;
                return;
            }
            container.innerHTML = mandatoryChannels.map(ch => `
                <div class="glass-pill p-3 rounded-2xl flex items-center justify-between">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-ios-blue/20 text-ios-cyan flex items-center justify-center shrink-0">
                            <i class="fa-brands fa-telegram text-lg"></i>
                        </div>
                        <div class="min-w-0">
                            <h4 class="text-xs font-bold text-white truncate">${ch.title}</h4>
                            <p class="text-[11px] text-white/55 truncate">${ch.username} • ${ch.members}</p>
                        </div>
                    </div>
                    <button onclick="removeChannel(${ch.id})" class="ios-btn w-8 h-8 rounded-xl bg-ios-red/20 text-ios-red flex items-center justify-center shrink-0">
                        <i class="fa-regular fa-trash-can text-xs"></i>
                    </button>
                </div>
            `).join('');
        }

        function addMandatoryChannel() {
            const title = document.getElementById('newChanTitle').value.trim();
            const username = document.getElementById('newChanUsername').value.trim();
            if (!title || !username) {
                showToast("Kanal nomi va username'ni kiriting", "Majburiy obuna", "fa-solid fa-triangle-exclamation text-ios-orange");
                return;
            }
            mandatoryChannels.push({
                id: Date.now(),
                title,
                username: username.startsWith('@') || username.startsWith('http') ? username : `@${username}`,
                members: 'Yangi ulangan'
            });
            localStorage.setItem('osontop_channels', JSON.stringify(mandatoryChannels));
            document.getElementById('newChanTitle').value = '';
            document.getElementById('newChanUsername').value = '';
            renderChannels();
            showToast(`${title} majburiy obunaga qo'shildi!`, "Kanal ulandi");
        }

        function removeChannel(id) {
            mandatoryChannels = mandatoryChannels.filter(c => c.id !== id);
            localStorage.setItem('osontop_channels', JSON.stringify(mandatoryChannels));
            renderChannels();
            showToast("Kanal ro'yxatdan o'chirildi", "Majburiy obuna", "fa-solid fa-trash text-ios-red");
        }

        // System Settings & Python Code Copy
        function toggleMaintenanceMode() {
            maintenanceEnabled = !maintenanceEnabled;
            const sw = document.getElementById('maintSwitch');
            if (maintenanceEnabled) {
                sw.className = 'w-12 h-6 rounded-full bg-ios-orange p-0.5 transition-all flex items-center justify-end';
                showToast("Texnik ta'mir rejimi yoqildi", "Tizim", "fa-solid fa-screwdriver-wrench text-ios-orange");
            } else {
                sw.className = 'w-12 h-6 rounded-full bg-white/20 p-0.5 transition-all flex items-center justify-start';
                showToast("Texnik ta'mir rejimi o'chirildi", "Tizim");
            }
        }

        function exportDatabaseBackup() {
            const backupData = {
                bot: "Oson Top Bot",
                exported_at: new Date().toISOString(),
                total_users: 14892,
                mandatory_channels: mandatoryChannels,
                recent_downloads: downloadHistory
            };
            const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `oson_top_backup_${Date.now()}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showToast("Baza nusxasi (.JSON) yuklab olindi!", "Database Backup");
        }

        function syncWithTelegramBackend() {
            showToast("Railway server va Bot bazasi sinxronlandi!", "Sinxronizatsiya", "fa-solid fa-rotate text-ios-cyan");
        }

        function copyPythonBackendCode() {
            const code = document.getElementById('pythonCodeBlock').innerText;
            const temp = document.createElement('textarea');
            temp.value = code;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast("Tayyor Python kod nusxalandi! GitHub main.py ga joylang.", "Kod Nusxalandi", "fa-solid fa-code text-ios-purple");
        }

        window.onload = function() {
            initUserProfile();
        };
    </script>
