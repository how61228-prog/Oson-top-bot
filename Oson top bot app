        // User Bottom Navigation Switcher
        function switchUserTab(tab) {
            ['home', 'history', 'guide'].forEach(t => {
                document.getElementById(`userTab${t.charAt(0).toUpperCase() + t.slice(1)}`).classList.add('hidden');
                const btn = document.getElementById(`navBtn-${t}`);
                btn.className = 'user-nav-btn ios-btn py-2.5 rounded-2xl flex flex-col items-center justify-center gap-1 text-white/60 hover:text-white';
            });

            document.getElementById(`userTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`navBtn-${tab}`);
            activeBtn.className = 'user-nav-btn ios-btn py-2.5 rounded-2xl flex flex-col items-center justify-center gap-1 bg-white/20 text-white';
        }

        // Handle URL Input & Auto-Detect Platform
        function handleUrlInput(val) {
            const clearBtn = document.getElementById('clearUrlBtn');
            const icon = document.getElementById('detectedIcon');
            const url = val.trim().toLowerCase();

            // Reset platform badge highlights
            document.querySelectorAll('.platform-badge').forEach(el => {
                el.classList.remove('ring-2', 'ring-ios-cyan', 'bg-white/20', 'scale-105');
            });

            if (url.length > 0) {
                clearBtn.classList.remove('hidden');
                clearBtn.classList.add('flex');
            } else {
                clearBtn.classList.add('hidden');
                clearBtn.classList.remove('flex');
                icon.className = 'fa-solid fa-link text-base text-white/50';
                return;
            }

            if (url.includes('instagram.com') || url.includes('instagr.am')) {
                icon.className = 'fa-brands fa-instagram text-lg text-pink-400';
                highlightBadge('badge-instagram');
            } else if (url.includes('tiktok.com')) {
                icon.className = 'fa-brands fa-tiktok text-lg text-cyan-300';
                highlightBadge('badge-tiktok');
            } else if (url.includes('youtube.com') || url.includes('youtu.be')) {
                icon.className = 'fa-brands fa-youtube text-lg text-red-400';
                highlightBadge('badge-youtube');
            } else if (url.includes('pinterest.com') || url.includes('pin.it')) {
                icon.className = 'fa-brands fa-pinterest text-lg text-rose-400';
                highlightBadge('badge-pinterest');
            } else {
                icon.className = 'fa-solid fa-globe text-base text-ios-cyan';
            }
        }

        function highlightBadge(id) {
            const el = document.getElementById(id);
            if (el) {
                el.classList.add('ring-2', 'ring-ios-cyan', 'bg-white/20', 'scale-105');
            }
        }

        function clearInput() {
            const inp = document.getElementById('mediaUrlInput');
            inp.value = '';
            handleUrlInput('');
            document.getElementById('mediaResultCard').classList.add('hidden');
        }

        async function pasteFromClipboard() {
            try {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    const text = await navigator.clipboard.readText();
                    if (text) {
                        document.getElementById('mediaUrlInput').value = text;
                        handleUrlInput(text);
                        showToast("Buferdan havola qo'yildi!", "Smart Clipboard");
                        return;
                    }
                }
            } catch (err) {}
            // Fallback demo link if clipboard permission is blocked in iframe
            fillDemoLink('instagram');
            showToast("Namuna Instagram Reels havolasi qo'yildi", "Smart Paste");
        }

        function fillDemoLink(platform) {
            const sampleLinks = {
                instagram: 'https://www.instagram.com/reel/C9xOsOnToP/',
                tiktok: 'https://vm.tiktok.com/ZMkOsonTopHD/',
                youtube: 'https://youtube.com/shorts/OsonTopShorts4K',
                pinterest: 'https://pin.it/7OsonTopPin Aesthetic'
            };
            const input = document.getElementById('mediaUrlInput');
            input.value = sampleLinks[platform];
            handleUrlInput(input.value);
        }

        function selectFormat(fmt) {
            selectedFormat = fmt;
            ['hd', 'nowm', 'mp3'].forEach(k => {
                const btn = document.getElementById(`fmt-${k}`);
                btn.className = 'format-btn ios-btn py-2 px-2 rounded-xl text-xs font-semibold text-white/65 hover:text-white flex items-center justify-center gap-1.5';
            });
            const active = document.getElementById(`fmt-${fmt}`);
            const icons = {
                hd: '<i class="fa-solid fa-film text-ios-cyan"></i><span>HD 1080p</span>',
                nowm: '<i class="fa-solid fa-wand-magic-sparkles text-ios-purple"></i><span>Suv belgisiz</span>',
                mp3: '<i class="fa-solid fa-music text-ios-pink"></i><span>MP3 Audio</span>'
            };
            active.className = 'format-btn ios-btn py-2 px-2 rounded-xl text-xs font-semibold bg-white/20 text-white shadow flex items-center justify-center gap-1.5';
            active.innerHTML = icons[fmt];
        }

        // Simulate or Execute Media Fetching
        function startMediaDownload() {
            if (maintenanceEnabled && currentRole === 'user') {
                showToast("Hozir botda texnik ishlar olib borilmoqda!", "Texnik ta'mir", "fa-solid fa-screwdriver-wrench text-ios-orange");
                return;
            }

            const url = document.getElementById('mediaUrlInput').value.trim();
            if (!url) {
                showToast("Iltimos, avval video havolasini kiriting!", "Havola topilmadi", "fa-solid fa-triangle-exclamation text-ios-orange");
                return;
            }

            const loader = document.getElementById('loadingScannerCard');
            const resultCard = document.getElementById('mediaResultCard');
            const bar = document.getElementById('scanProgressBar');
            const pct = document.getElementById('scanPercent');

            resultCard.classList.add('hidden');
            loader.classList.remove('hidden');

            let progress = 18;
            bar.style.width = `${progress}%`;
            pct.textContent = `${progress}%`;

            const interval = setInterval(() => {
                progress += Math.floor(Math.random() * 28) + 15;
                if (progress >= 100) {
                    progress = 100;
                    clearInterval(interval);
                    setTimeout(() => {
                        loader.classList.add('hidden');
                        presentMediaResult(url);
                    }, 220);
                }
                bar.style.width = `${progress}%`;
                pct.textContent = `${progress}%`;
            }, 240);
        }

        function presentMediaResult(url) {
            const low = url.toLowerCase();
            let platform = 'MEDIA STREAM';
            let thumb = 'https://placehold.co/300x400/1e293b/38bdf8?text=Video+HD';
            let title = 'Oson Top orqali yuklangan original sifatli media fayl';
            let size = '12.8 MB';
            let duration = '00:38';

            if (low.includes('instagram') || low.includes('instagr.am')) {
                platform = 'INSTAGRAM REELS';
                thumb = 'https://placehold.co/300x400/500724/f472b6?text=Insta+Reels';
                title = 'Instagram Reels — Original 1080p Full HD (Suv belgisiz)';
                size = '15.2 MB';
            } else if (low.includes('tiktok')) {
                platform = 'TIKTOK NO-WATERMARK';
                thumb = 'https://placehold.co/300x400/083344/22d3ee?text=TikTok+Original';
                title = 'TikTok Trend Video — Logotipsiz toza nusxa';
                size = '8.6 MB';
            } else if (low.includes('youtube') || low.includes('youtu.be')) {
                platform = 'YOUTUBE SHORTS / HD';
                thumb = 'https://placehold.co/300x400/450a0a/f87171?text=YouTube+HD';
                title = 'YouTube Shorts — Yuqori sifatli video va stereo audio';
                size = '19.4 MB';
            } else if (low.includes('pin')) {
                platform = 'PINTEREST IDEA PIN';
                thumb = 'https://placehold.co/300x400/4c0519/fb7185?text=Pinterest+Pin';
                title = 'Pinterest Aesthetic Video Pin — Original Quality';
                size = '7.3 MB';
            }

            const fmtLabels = {
                hd: 'MP4 • 1080p HD',
                nowm: 'MP4 • No Watermark',
                mp3: 'MP3 • 320kbps Audio'
            };

            if (selectedFormat === 'mp3') {
                size = '3.4 MB';
            }

            document.getElementById('resultPlatformTag').textContent = platform;
            document.getElementById('resultThumb').src = thumb;
            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultSize').textContent = size;
            document.getElementById('resultDuration').textContent = duration;
            document.getElementById('resultFormatBadge').textContent = fmtLabels[selectedFormat];

            currentMediaItem = {
                id: Date.now(),
                platform,
                url,
                title,
                format: fmtLabels[selectedFormat],
                size,
                time: 'Hozirgina',
                thumb
            };

            // Save to History
            downloadHistory.unshift(currentMediaItem);
            localStorage.setItem('osontop_history', JSON.stringify(downloadHistory.slice(0, 20)));
            renderHistory();

            // Increment Admin KPI counter live
            const kpiEl = document.getElementById('kpiTodayDownloads');
            const currentCount = parseInt(kpiEl.textContent.replace(/,/g, ''), 10) || 3640;
            kpiEl.textContent = (currentCount + 1).toLocaleString();

            document.getElementById('mediaResultCard').classList.remove('hidden');
            showToast("Media fayl topildi! Yuklab olishingiz mumkin.", "Muvaffaqiyatli");
        }

        // Send Media directly to Telegram Bot Chat via WebApp SDK
        function sendMediaToBotChat() {
            if (!currentMediaItem) return;
            const payload = JSON.stringify({
                action: 'download_media',
                url: currentMediaItem.url,
                format: selectedFormat,
                platform: currentMediaItem.platform
            });

            if (tg && tg.initData) {
                tg.sendData(payload);
            } else {
                showToast("Telegram botga so'rov yuborildi! Fayl chatga tashlanadi.", "Bot Chatiga Yuborildi", "fa-brands fa-telegram text-ios-cyan");
            }
        }

        function triggerDirectSave() {
            if (!currentMediaItem) return;
            showToast(`${currentMediaItem.format} fayl qurilmangizga saqlanmoqda...`, "Yuklab olish boshlandi", "fa-solid fa-cloud-arrow-down text-ios-green");
        }

        // Render User History List
        function renderHistory() {
            const container = document.getElementById('historyListContainer');
            const badge = document.getElementById('historyCountBadge');
            badge.textContent = downloadHistory.length;

            if (downloadHistory.length === 0) {
                container.innerHTML = `
                    <div class="glass-card p-8 text-center space-y-2">
                        <i class="fa-solid fa-folder-open text-3xl text-white/30"></i>
                        <p class="text-sm font-semibold text-white/70">Tarix hozircha bo'sh</p>
                        <p class="text-xs text-white/45">Yuklab olingan barcha videolar shu yerda saqlanadi</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = downloadHistory.map(item => `
                <div class="glass-card p-3 flex items-center gap-3">
                    <img src="${item.thumb}" alt="thumb" class="w-14 h-16 rounded-xl object-cover shrink-0 border border-white/10">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] font-bold uppercase text-ios-cyan">${item.platform}</span>
                            <span class="text-[10px] text-white/40">• ${item.time}</span>
                        </div>
                        <h4 class="text-xs font-bold text-white truncate mt-0.5">${item.title}</h4>
                        <p class="text-[11px] text-white/55 mt-0.5">${item.format} • ${item.size}</p>
                    </div>
                    <button onclick="reloadFromHistory('${item.url}')" class="ios-btn w-9 h-9 rounded-xl glass-pill flex items-center justify-center text-ios-cyan shrink-0">
                        <i class="fa-solid fa-rotate-right text-xs"></i>
                    </button>
                </div>
            `).join('');
        }

        function reloadFromHistory(url) {
            switchUserTab('home');
            const input = document.getElementById('mediaUrlInput');
            input.value = url;
            handleUrlInput(url);
            startMediaDownload();
        }

        function clearHistory() {
            downloadHistory = [];
            localStorage.setItem('osontop_history', '[]');
            renderHistory();
            showToast("Yuklashlar tarixi tozalandi", "Tarix", "fa-solid fa-trash text-ios-red");
        }

        // ==========================================
        // ADMIN PANEL FUNCTIONS
        // ==========================================
        function switchAdminTab(tab) {
            const map = {
                stats: 'adminSubStats',
                broadcast: 'adminSubBroadcast',
                channels: 'adminSubChannels',
                system: 'adminSubSystem'
            };
